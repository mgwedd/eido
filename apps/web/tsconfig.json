{
  "extends": "@eido/typescript-config/nextjs.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/web.tsbuildinfo",
    "paths": {
      "@/*": ["./*"],
      "@eido/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next/dev"],
  "references": [
    { "path": "../../packages/schemas" },
    { "path": "../../packages/ui" }
  ]
}
