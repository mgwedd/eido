# Web app sign-in (docs/auth0-setup.md). Copy to .env.local and fill in; never commit it.
# These are read by apps/web only. Core and the gate never see them.

# Auth0 tenant domain and the "Eido" regular web application.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32 random bytes, hex: openssl rand -hex 32
AUTH0_SECRET=

# Every origin Eido is served on, comma-separated. Each needs /auth/callback registered in Auth0.
APP_BASE_URL=http://localhost:3000,https://HOST.ts.net:8443

# Exactly one owner. Assistants are optional and comma-separated.
EIDO_OWNER_EMAIL=owner@example.test
EIDO_ASSISTANT_EMAILS=assistant@example.test
