{
  "name": "eido",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check:deps": "depcruise packages apps --config .dependency-cruiser.mts",
    "check:deps-fixture": "node scripts/check-boundary-fixture.ts",
    "check:gate-deps": "node scripts/check-gate-deps.ts",
    "check:secrets": "node scripts/secret-scan.ts",
    "check:versions": "node scripts/check-exact-versions.ts",
    "check:lint-coverage": "node scripts/check-lint-coverage.ts",
    "check:invariants": "node scripts/check-invariant-tests.ts",
    "check:no-js": "node scripts/check-no-js.ts",
    "check:no-js-fixture": "node scripts/check-no-js.ts --self-test",
    "check:no-telemetry": "node scripts/check-no-telemetry.ts",
    "check:no-telemetry-fixture": "node scripts/check-no-telemetry.ts --self-test",
    "verify": "node scripts/verify.ts",
    "stack:dev": "node --disable-warning=ExperimentalWarning infra/stack/bin.ts dev",
    "stack:prod": "node --disable-warning=ExperimentalWarning infra/stack/bin.ts prod",
    "stack:stop": "node --disable-warning=ExperimentalWarning infra/stack/bin.ts stop",
    "stack:status": "node --disable-warning=ExperimentalWarning infra/stack/bin.ts status"
  },
  "devDependencies": {
    "@eido/eslint-config": "workspace:*",
    "@eido/typescript-config": "workspace:*",
    "dependency-cruiser": "18.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  }
}
