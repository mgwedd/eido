{
  "name": "eido",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check:deps": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check:deps-fixture": "node scripts/check-boundary-fixture.mjs",
    "check:gate-deps": "node scripts/check-gate-deps.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:versions": "node scripts/check-exact-versions.mjs",
    "check:lint-coverage": "node scripts/check-lint-coverage.mjs",
    "check:no-js": "node scripts/check-no-js.mjs",
    "check:no-js-fixture": "node scripts/check-no-js.mjs --self-test",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@eido/eslint-config": "workspace:*",
    "@eido/typescript-config": "workspace:*",
    "dependency-cruiser": "18.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  }
}
