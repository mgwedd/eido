# One dependency per line: name, then a one-line reason after "#".
# CI fails if packages/gate/package.json lists anything (dependencies, optionalDependencies,
# peerDependencies or devDependencies) that is not here, or if a line has no reason.
@eido/schemas  # intent types and validators shared with the rest of the system
@eido/eslint-config  # shared ESLint flat config used by the lint script
@eido/typescript-config  # shared tsconfig base used by the typecheck script
eslint  # lint script
typescript  # typecheck script
vitest  # test script
@vitest/coverage-v8  # test script coverage (v8 provider, same version as vitest); dev-only, no runtime or network access
imapflow  # IMAP client for Proton Bridge on loopback only (#195); reads and the closed write set (append, move); no install scripts
nodemailer  # SMTP client for Proton Bridge on loopback only (#195): sends from the assistant identity; no dependencies, no install scripts
mailparser  # Parses approved RFC 2822 messages in Gmail draft and send requests
@types/mailparser  # TypeScript declarations for the mailparser dependency
# Transitive packages of imapflow 2.4.0, each checked for install scripts (none) in #195: pino, @pinojs/redact,
# pino-abstract-transport, pino-std-serializers, libqp, libmime, libbase64, @zone-eu/mailsplit, socks, ip-address,
# smart-buffer, iconv-lite, safer-buffer, encoding-japanese, atomic-sleep, on-exit-leak-free, process-warning,
# quick-format-unescaped, real-require, safe-stable-stringify, sonic-boom, split2, thread-stream.
