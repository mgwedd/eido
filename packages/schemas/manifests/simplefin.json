{
  "name": "simplefin",
  "version": 1,
  "description": "SimpleFIN Bridge bank connector (read-only): accounts and transaction history.",
  "auth": {
    "type": "basic-url",
    "scopes": []
  },
  "egress": {
    "hosts": [
      {
        "host": "bridge.simplefin.org",
        "methods": ["GET"],
        "pathPrefixes": ["/simplefin"]
      }
    ]
  },
  "operations": [
    {
      "name": "listAccounts",
      "effect": "read",
      "reversibility": "reversible",
      "defaultTier": "auto",
      "sensitivity": "high",
      "untrustedOutput": true,
      "authScopes": [],
      "routes": [
        {
          "host": "bridge.simplefin.org",
          "method": "GET",
          "pathPattern": "/simplefin/accounts"
        }
      ]
    },
    {
      "name": "listTransactions",
      "effect": "read",
      "reversibility": "reversible",
      "defaultTier": "auto",
      "sensitivity": "high",
      "untrustedOutput": true,
      "authScopes": [],
      "routes": [
        {
          "host": "bridge.simplefin.org",
          "method": "GET",
          "pathPattern": "/simplefin/accounts"
        }
      ]
    }
  ],
  "triggers": [
    {
      "kind": "poll",
      "stream": "transactions",
      "intervalSeconds": 21600
    }
  ],
  "ledgerMapping": {
    "source": "simplefin",
    "refField": "id"
  },
  "health": {
    "backoff": {
      "baseMs": 1000,
      "maxMs": 300000,
      "jitter": true
    },
    "breaker": {
      "failureThreshold": 3,
      "halfOpenProbeAfterMs": 60000
    },
    "rateLimit": {
      "requestsPerDay": 24
    }
  }
}
