{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateThingsTodoItem",
  "description": "One Things to-do item returned from gate read endpoints.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "maxLength": 500 },
    "status": { "enum": ["open", "completed", "canceled"] },
    "notes": { "type": "string", "maxLength": 20000 },
    "tags": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "maxLength": 100 }
    },
    "area": {
      "oneOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }]
    },
    "project": {
      "oneOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }]
    },
    "dueDate": {
      "oneOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }]
    },
    "activationDate": {
      "oneOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }]
    },
    "modificationDate": {
      "oneOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }]
    },
    "creationDate": {
      "oneOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }]
    }
  },
  "required": [
    "id",
    "name",
    "status",
    "notes",
    "tags",
    "area",
    "project",
    "dueDate",
    "activationDate",
    "modificationDate",
    "creationDate"
  ],
  "additionalProperties": false
}
