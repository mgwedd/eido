{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StackSettings",
  "description": "The stack settings file (stack.env) as the supervisor reports it (#644): every set key, and the SHA-256 of the file a write must name, or null when there is no file.",
  "type": "object",
  "properties": {
    "sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "title": "StackSettingValues",
      "description": "Set keys only. An unset key is absent.",
      "type": "object",
      "properties": {
        "EIDO_STACK_LOG_DIR": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_TAILNET_HOST": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_EDGE_PORT": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_WEB_PORT": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_CORE_PORT": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_GATE_PHONE_PORT": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_GATE_DATA_DIR": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_DATA_DIR": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_GATE_SOCKET": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_GATE_CONTROL_SOCKET": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_GATE_KEYCHAIN_PATH": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_PROFILE_AUDIT_EPOCH": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_FILE_HELPER_PATH": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_FILE_HELPER_SHA256": {
          "type": "string",
          "maxLength": 4096
        },
        "EIDO_FILES_SYNC": {
          "type": "string",
          "maxLength": 4096
