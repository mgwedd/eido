{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatePermissionList",
  "description": "Kind-level permission tiers with shipped defaults, signed overrides and the effective tier from active pinned connectors. Payload-specific guards can still raise a tier or forbid an individual intent.",
  "type": "object",
  "properties": {
    "tiers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "title": "GatePermissionTier",
        "type": "object",
        "properties": {
          "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
          "tier": {
            "type": "string",
            "enum": ["auto", "approval", "forbidden"]
          },
          "default": {
            "description": "The shipped default for this kind, or null when the shipped table has no entry.",
            "oneOf": [
              { "type": "string", "enum": ["auto", "approval"] },
              { "type": "null" }
            ]
          },
          "override": {
            "description": "The active signed override, omitted when none exists for this kind.",
            "type": "string",
            "enum": ["auto", "approval"]
          },
          "reason": {
            "type": "string",
            "enum": [
              "unknown_kind",
              "no_operation",
              "ambiguous_operation",
              "manifest_forbidden",
              "root_not_allowed",
              "connector_disabled",
              "event_not_found"
            ]
          }
        },
        "required": ["kind", "tier", "default"],
        "additionalProperties": false
      }
    },
    "forbiddenKinds": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    }
  },
  "required": ["tiers", "forbiddenKinds"],
  "additionalProperties": false
}
