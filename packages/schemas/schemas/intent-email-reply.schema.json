{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmailReplyIntent",
  "description": "Reply to a message.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "email.reply"
    },
    "args": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Message id to reply to"
        },
        "messageSha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 (lowercase hex) of the raw message, so only that exact message is the target"
        },
        "replyAll": {
          "type": "boolean",
          "description": "True replies to all recipients"
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320
          },
          "description": "Recipients the reply goes to, as approved"
        },
        "cc": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320
          },
          "description": "Cc recipients, as approved"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "Plain-text body"
        }
      },
      "required": ["messageId", "messageSha256", "replyAll", "to", "body"],
      "additionalProperties": false
    }
  },
  "required": ["kind", "args"],
  "additionalProperties": false
}
