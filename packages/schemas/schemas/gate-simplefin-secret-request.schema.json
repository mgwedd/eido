{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateSimpleFinSecretRequest",
  "description": "Body of POST /admin/secrets/simplefin (#661): the passkey assertion over the prepared ceremony, and the SimpleFIN setup token. The gate claims the access URL with it and seals that in its vault; neither is sent back.",
  "type": "object",
  "properties": {
    "approval": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "assertion": {
          "$ref": "gate-webauthn-assertion.schema.json"
        }
      },
      "required": ["id", "nonce", "assertion"],
      "additionalProperties": false
    },
    "setupToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": ["approval", "setupToken"],
  "additionalProperties": false
}
