{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateAuditChainStatus",
  "description": "Result of the gate's verifyChain() (#9). Anything but ok true is shown as a failure; an unreachable gate is an error response, never ok.",
  "oneOf": [
    {
      "title": "GateAuditChainOk",
      "description": "Chain verified.",
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["ok", "rows"],
      "additionalProperties": false
    },
    {
      "title": "GateAuditChainBroken",
      "description": "Chain failed verification.",
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "brokenAtSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "enum": [
            "prev_hash_mismatch",
            "seq_gap",
            "bad_genesis",
            "head_mismatch"
          ],
          "maxLength": 32
        }
      },
      "required": ["ok", "brokenAtSeq", "reason"],
      "additionalProperties": false
    }
  ]
}
