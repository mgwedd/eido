{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateFileHelperResponse",
  "description": "The single line the native file helper writes to stdout (ADR 0006). Errors carry a fixed code and a fixed message; never a path or OS text.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "op": {
          "const": "identify"
        },
        "canonicalPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "dev": {
          "type": "string",
          "pattern": "^[0-9a-f]{1,40}$"
        },
        "ino": {
          "type": "string",
          "pattern": "^[0-9a-f]{1,40}$"
        }
      },
      "required": ["ok", "op", "canonicalPath", "dev", "ino"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "op": {
          "enum": ["create", "move", "trash", "restore"]
        }
      },
      "required": ["ok", "op"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "code": {
          "enum": [
            "bad_request",
            "invalid_path",
            "root_changed",
            "not_found",
            "exists",
            "not_a_directory",
            "symlink",
            "io",
            "unsupported"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": ["ok", "code", "message"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "op": {
          "const": "read"
        },
        "contentBase64": {
          "type": "string",
          "maxLength": 11184812,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": ["ok", "op", "contentBase64"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "op": {
          "const": "list"
        },
        "entries": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "kind": {
                "enum": ["file", "directory"]
              }
            },
            "required": ["name", "kind"],
            "additionalProperties": false
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": ["ok", "op", "entries", "truncated"],
      "additionalProperties": false
    }
  ]
}
