{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmailLabelIntent",
  "description": "Add or remove labels on messages.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "email.label"
    },
    "args": {
      "type": "object",
      "properties": {
        "messageIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": "Message ids"
        },
        "add": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": "Labels to add"
        },
        "remove": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": "Labels to remove"
        }
      },
      "required": ["messageIds"],
      "additionalProperties": false
    }
  },
  "required": ["kind", "args"],
  "additionalProperties": false
}
