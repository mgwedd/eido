{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileAccountAssignment",
  "description": "Assign a connector account, calendar or mailbox to an entity.",
  "type": "object",
  "properties": {
    "connector": { "type": "string", "minLength": 1, "maxLength": 50 },
    "accountRef": { "type": "string", "minLength": 1, "maxLength": 320 },
    "entityId": { "type": "string", "minLength": 36, "maxLength": 36 }
  },
  "required": ["connector", "accountRef", "entityId"],
  "additionalProperties": false
}
