{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateThingsProjectItem",
  "description": "One Things project item returned from gate read endpoints.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "maxLength": 500 },
    "area": {
      "oneOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }]
    },
    "status": { "enum": ["open", "completed", "canceled"] },
    "headings": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "maxLength": 200 }
    },
    "todoCount": { "type": "integer", "minimum": 0 },
    "notes": { "type": "string", "maxLength": 20000 },
    "dueDate": {
      "oneOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }]
    },
    "activationDate": {
      "oneOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }]
    },
    "tags": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "maxLength": 100 }
    }
  },
  "required": ["id", "name", "area", "status", "headings", "todoCount"],
  "additionalProperties": false
}
