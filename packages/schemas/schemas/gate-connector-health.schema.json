{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateConnectorHealth",
  "description": "Response of connector health (#24 getConnectorHealth), used by the Today page. It has no fields for credentials or payload bodies.",
  "type": "object",
  "properties": {
    "connectors": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "title": "GateConnectorHealthItem",
        "description": "Health of one connector.",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Connector name, as in the connector manifest (#10)."
          },
          "health": {
            "type": "string",
            "enum": ["healthy", "degraded", "open"],
            "maxLength": 32
          },
          "consecutiveFailures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "lastError": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Short error summary shown to the user. The gate writes it without tokens, request headers or upstream response bodies."
          },
          "nextAttemptAt": {
            "type": "string",
            "format": "date-time",
            "minLength": 20,
            "maxLength": 40
          },
          "requestsToday": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000,
            "description": "Upstream requests the gate proxy sent today (local day), for a connector whose manifest sets a daily rate limit."
          },
          "requestLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "description": "The manifest's daily request limit."
          },
          "nextSyncAt": {
            "type": "string",
            "format": "date-time",
            "minLength": 20,
            "maxLength": 40,
            "description": "When the daily request budget is spent: the next local midnight, when reads are admitted again."
          },
          "messages": {
            "type": "array",
            "maxItems": 20,
            "description": "Connector messages for the user, such as accounts that need an entity or errors the upstream reported. Added by the data plane; never credentials, URLs or response bodies.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "required": ["name", "health", "consecutiveFailures"],
        "additionalProperties": false
      }
    }
  },
  "required": ["connectors"],
  "additionalProperties": false
}
