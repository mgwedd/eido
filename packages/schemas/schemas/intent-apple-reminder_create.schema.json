{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppleReminderCreateIntent",
  "description": "Create a reminder in an Apple Reminders list through EventKit. Requires signed approval.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "apple.reminder_create"
    },
    "sensitivity": {
      "type": "string",
      "enum": ["sensitive"],
      "maxLength": 20
    },
    "args": {
      "type": "object",
      "properties": {
        "listId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "due": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "format": "date-time"
        }
      },
      "required": ["listId", "title"],
      "additionalProperties": false
    }
  },
  "required": ["kind", "args"],
  "additionalProperties": false
}
