{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateAppleEventList",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "calendarId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "title": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "start": {
            "type": "string",
            "minLength": 20,
            "maxLength": 40,
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "minLength": 20,
            "maxLength": 40,
            "format": "date-time"
          },
          "allDay": {
            "type": "boolean"
          },
          "location": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 20000
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 20000
              },
              {
                "type": "null"
              }
            ]
          },
          "hasAttendees": {
            "type": "boolean",
            "description": "The event has attendees. The Helper refuses update_event for it."
          },
          "recurring": {
            "type": "boolean",
            "description": "The event belongs to a series: it has recurrence rules or is a detached occurrence. Its id carries the recurrence: prefix. The Helper refuses update_event for it."
          },
          "modifiedAt": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 20,
                "maxLength": 40,
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "calendarId",
          "title",
          "start",
          "end",
          "allDay",
          "location",
          "notes",
          "modifiedAt",
          "hasAttendees",
          "recurring"
        ],
        "additionalProperties": false
      }
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Items the Helper dropped because they failed its output checks. Absent from an older Helper; the gate's read routes always report it."
    }
  },
  "required": ["events"],
  "additionalProperties": false
}
