{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateFileRootsRequest",
  "description": "The owner's requested local file roots (#313), before the gate captures each root's canonical path and identity with the native helper and prepares the signed policy.set ceremony.",
  "type": "object",
  "properties": {
    "roots": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "trashDir": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]*[A-Za-z0-9_-]$"
          }
        },
        "required": ["id", "path", "trashDir"],
        "additionalProperties": false
      }
    }
  },
  "required": ["roots"],
  "additionalProperties": false
}
