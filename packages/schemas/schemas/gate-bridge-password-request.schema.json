{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateBridgePasswordRequest",
  "description": "Body of POST /admin/secrets/bridge (#661): the passkey assertion over the prepared ceremony, the pin it names, and the Bridge password. The gate seals the password in its vault and never sends it back.",
  "type": "object",
  "properties": {
    "approval": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "assertion": {
          "$ref": "gate-webauthn-assertion.schema.json"
        }
      },
      "required": ["id", "nonce", "assertion"],
      "additionalProperties": false
    },
    "certificateSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": ["approval", "certificateSha256", "password"],
  "additionalProperties": false
}
