{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppleEventUpdateIntent",
  "description": "Replace the editable fields of one non-recurring Apple event. Omitted location and notes are cleared. Requires signed approval.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "apple.event_update"
    },
    "sensitivity": {
      "type": "string",
      "enum": ["sensitive"],
      "maxLength": 20
    },
    "args": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "calendarId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "start": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "format": "date-time"
        },
        "allDay": {
          "type": "boolean"
        },
        "location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        }
      },
      "required": ["id", "calendarId", "title", "start", "end", "allDay"],
      "additionalProperties": false
    }
  },
  "required": ["kind", "args"],
  "additionalProperties": false
}
