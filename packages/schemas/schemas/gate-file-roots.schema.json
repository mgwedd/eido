{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateFileRoots",
  "description": "The owner-signed set of local file roots the gate may operate in (#313). Stored only through a signed policy.set control approval on target file-roots; an unsigned, replayed, tampered or superseded set is never loaded.",
  "type": "object",
  "properties": {
    "roots": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "root": { "$ref": "gate-file-root.schema.json" }
        },
        "required": ["id", "root"],
        "additionalProperties": false
      }
    }
  },
  "required": ["roots"],
  "additionalProperties": false
}
