{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreApiObligationList",
  "type": "object",
  "properties": {
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "action": { "type": "string" },
          "party": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "dueAt": {
            "oneOf": [
              { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              { "type": "null" }
            ]
          },
          "status": { "type": "string", "enum": ["open", "done", "dismissed"] },
          "direction": {
            "oneOf": [
              { "type": "string", "enum": ["owed", "waiting"] },
              { "type": "null" }
            ]
          },
          "hasDraftIntent": { "type": "boolean" },
          "updatedAt": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "entity": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "tag": { "type": "string" }
            },
            "required": ["id", "name", "tag"],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "documentId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "span": { "$ref": "source-span.schema.json" },
              "title": { "type": "string" }
            },
            "required": ["documentId", "span"],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "action",
          "party",
          "dueAt",
          "status",
          "direction",
          "entity",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "nextOffset": {
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    }
  },
  "required": ["obligations", "nextOffset"],
  "additionalProperties": false
}
