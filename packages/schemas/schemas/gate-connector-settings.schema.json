{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateConnectorSettings",
  "description": "Authenticated phone view of each pinned connector's live health, declared auth scopes, pin timestamp, pinned manifest hash, last successful read and manifest drift detail, with the gate's own time. Fields other than the original ones are optional per connector. `unpinned` lists the connectors with a reviewed manifest placed on the Mac and no pin yet (#627), with the tool names and scopes the owner reviews before a first pin. It contains no credentials.",
  "type": "object",
  "properties": {
    "connectors": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "title": "GateConnectorSetting",
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "enabled": { "type": "boolean" },
          "pinnedAt": {
            "type": "string",
            "format": "date-time",
            "minLength": 20,
            "maxLength": 40
          },
          "scopes": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "health": {
            "type": "string",
            "enum": ["healthy", "degraded", "open"]
          },
          "consecutiveFailures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "lastError": { "type": "string", "minLength": 1, "maxLength": 500 },
          "nextAttemptAt": {
            "type": "string",
            "format": "date-time",
            "minLength": 20,
            "maxLength": 40
          },
          "lastSuccessAt": {
            "type": "string",
            "format": "date-time",
            "minLength": 20,
            "maxLength": 40
          },
          "manifestHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bridgePasswordStored": { "type": "boolean" },
          "accountEmail": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
          },
          "drift": {
            "type": "object",
            "properties": {
              "added": {
                "type": "array",
                "maxItems": 200,
                "items": { "type": "string", "minLength": 1, "maxLength": 256 }
              },
              "removed": {
                "type": "array",
                "maxItems": 200,
                "items": { "type": "string", "minLength": 1, "maxLength": 256 }
              }
            },
            "required": ["added", "removed"],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "enabled",
          "pinnedAt",
          "scopes",
          "health",
          "consecutiveFailures"
        ],
        "additionalProperties": false
      }
    },
    "unpinned": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "title": "GateUnpinnedConnector",
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "operations": {
            "type": "array",
            "maxItems": 200,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "scopes": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        },
        "required": ["name", "operations", "scopes"],
        "additionalProperties": false
      }
    },
    "asOf": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 40
    }
  },
  "required": ["connectors"],
  "additionalProperties": false
}
