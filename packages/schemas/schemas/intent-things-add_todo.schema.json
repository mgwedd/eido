{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThingsAddTodoIntent",
  "description": "Capture a to-do in Things.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "things.add_todo"
    },
    "sensitivity": {
      "type": "string",
      "enum": ["sensitive"],
      "maxLength": 20,
      "description": "When 'sensitive', core's classifier flagged the text as sensitive. Inside the hashed payload."
    },
    "args": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "To-do title"
        },
        "notes": {
          "type": "string",
          "maxLength": 20000,
          "description": "Notes"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "Free text of the to-do"
        },
        "when": {
          "type": "string",
          "maxLength": 100,
          "description": "When"
        },
        "deadline": {
          "type": "string",
          "maxLength": 100,
          "description": "Deadline"
        },
        "tags": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "checklist": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["kind", "args"],
  "additionalProperties": false
}
