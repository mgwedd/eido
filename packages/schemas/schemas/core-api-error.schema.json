{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreApiError",
  "description": "Body of a non-2xx response from core's HTTP API. `fields` carries one entry per invalid field for code invalid; `referencedBy` names the tables that reference an entity for code entity_in_use. invalid_transition: the obligation is not in a state the requested change applies to.",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "duplicate_name",
            "duplicate_tag",
            "not_found",
            "entity_in_use",
            "invalid_transition",
            "bad_request",
            "unsupported_media_type",
            "payload_too_large",
            "method_not_allowed",
            "misdirected_request",
            "busy",
            "gate_unavailable",
            "internal"
          ]
        },
        "message": { "type": "string", "maxLength": 200 },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string", "maxLength": 200 },
              "message": { "type": "string", "maxLength": 200 }
            },
            "required": ["field", "message"],
            "additionalProperties": false
          }
        },
        "referencedBy": {
          "type": "array",
          "items": { "type": "string", "maxLength": 100 }
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  },
  "required": ["error"],
  "additionalProperties": false
}
