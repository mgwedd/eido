{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateBridgePinRequest",
  "description": "Body of POST /admin/secrets/bridge-pin (#661): the passkey assertion over the prepared pin change, and the new pin it names.",
  "type": "object",
  "properties": {
    "approval": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "assertion": {
          "$ref": "gate-webauthn-assertion.schema.json"
        }
      },
      "required": ["id", "nonce", "assertion"],
      "additionalProperties": false
    },
    "certificateSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": ["approval", "certificateSha256"],
  "additionalProperties": false
}
