{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": ["tsconfig.base.json", "tsconfig.json"],
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["EIDO_TAILNET_HOST"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**", "node_modules/.cache/tsc/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#check:deps": {
      "inputs": [
        "apps/**/*.{ts,tsx,js,mjs,cjs,json}",
        "packages/**/*.{ts,tsx,js,mjs,cjs,json}",
        ".dependency-cruiser.cjs",
        "tsconfig*.json",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/dist/**"
      ]
    },
    "//#check:deps-fixture": {
      "dependsOn": ["//#check:deps"],
      "inputs": [
        "fixtures/boundary-violation/**",
        ".dependency-cruiser.cjs",
        "scripts/check-boundary-fixture.mjs"
      ]
    },
    "//#check:gate-deps": {
      "inputs": [
        "packages/gate/package.json",
        "packages/gate/ALLOWED_DEPENDENCIES",
        "scripts/check-gate-deps.mjs"
      ]
    },
    "//#check:lint-coverage": {
      "inputs": [
        "apps/**",
        "packages/**",
        "scripts/check-lint-coverage.mjs",
        "tsconfig*.json",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/dist/**"
      ]
    },
    "//#check:invariants": {
      "inputs": [
        "scripts/check-invariant-tests.mjs",
        "packages/gate/src/internal/approvals.test.ts",
        "packages/gate/src/internal/audit.test.ts",
        "packages/gate/src/internal/connectors.test.ts",
        "packages/gate/src/internal/egress.test.ts",
        "packages/gate/src/internal/executor.test.ts",
        "packages/gate/src/internal/intents.test.ts",
        "packages/gate/src/internal/vault/authorized-call.test.ts"
      ]
    },
    "//#check:no-js": {
      "inputs": [
        "**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/dist/**"
      ]
    },
    "//#check:no-js-fixture": {
      "inputs": ["scripts/check-no-js.mjs"]
    },
    "//#check:no-telemetry": {
      "inputs": [
        "apps/**/*.{ts,tsx,js,jsx,mjs,cjs,swift,json}",
        "apps/*/package.json",
        "packages/*/package.json",
        "package.json",
        "pnpm-lock.yaml",
        "scripts/check-no-telemetry.mjs",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/dist/**"
      ]
    },
    "//#check:no-telemetry-fixture": {
      "inputs": ["scripts/check-no-telemetry.mjs"]
    },
    "//#check:secrets": {
      "inputs": [
        "**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/dist/**"
      ]
    },
    "//#check:versions": {
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "infra/package.json",
        ".node-version",
        "scripts/check-exact-versions.mjs"
      ]
    },
    "//#format:check": {
      "inputs": [
        "**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/dist/**"
      ]
    }
  }
}
